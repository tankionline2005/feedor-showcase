# Copy to .env and fill in. Never commit .env.

# Web login (single user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Random string for signing the session cookie:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# true once the site is served over HTTPS
COOKIE_SECURE=false

# Default Telegram app credentials from https://my.telegram.org (an account may override them)
TG_API_ID=
TG_API_HASH=

# HTTPS on your own domain (the domain's A records point to the server):
#   DOMAIN=example.com
#   OLD_DOMAINS=old.com www.old.com # optional: former addresses, led to DOMAIN with the same path
#   COMPOSE_PROFILES=https          # starts Caddy, which gets the certificate itself
#   WEB_PORT=127.0.0.1:8000         # the app is reached only through Caddy
#   COOKIE_SECURE=true
#   FORWARDED_ALLOW_IPS=*           # trust Caddy's X-Forwarded-For (real visitor IPs)

# docker-compose
POSTGRES_PASSWORD=change-me
WEB_PORT=80

LOG_LEVEL=INFO
